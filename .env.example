# Session signing
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file
DATABASE_URL=sqlite:///./urlaubsplaner.db

# "local" = dev "login as" picker (no Azure setup needed, for prototyping).
# "microsoft" = real Microsoft Entra ID SSO, requires the MICROSOFT_* settings below.
AUTH_MODE=local

# Microsoft Entra ID (Azure AD) app registration - only needed when AUTH_MODE=microsoft
# Register at https://portal.azure.com -> Entra ID -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Must match a Redirect URI configured on the app registration
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback

# Email of the first user to sign in; they are auto-promoted to Admin
# so there's a way into the app before any admin UI has been used.
BOOTSTRAP_ADMIN_EMAIL=
